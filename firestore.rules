// Server-only bot data under telegram_bots/{botId}.
// state/settings holds configuration and encrypted provider credentials.
// accounts holds approved Telegram identities and connection permissions.
// requests holds pending approvals. chats/{chatId}/history holds messages.
// updates holds an encrypted inbox payload until processing completes.
// The Python server authenticates with its dedicated IAM service account.
// Mini App clients use the authenticated FastAPI routes.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
