# Telegram bot token and administrator's Telegram user ID
BOT_TOKEN=
ADMIN_ID=7150170715

# Optional account allowlist. Leave blank to approve the Telegram connection in the bot.
BUSINESS_USER_ID=

# Public HTTPS URL for the Mini App button in Telegram.
WEBAPP_URL=
# Optional HTTPS base for webhook delivery. Render sets its public URL automatically.
TELEGRAM_WEBHOOK_BASE_URL=
# Local bind address. A hosting platform with PORT set uses 0.0.0.0 by default.
WEBAPP_HOST=
WEBAPP_PORT=8080

# Optional browser access on localhost only. Use a random secret of at least 24 characters.
LOCAL_ADMIN_TOKEN=

# Optional persistent database path and Fernet key. Keep the key with the same database.
DB_PATH=
SETTINGS_ENCRYPTION_KEY=

# Additional trusted OpenAI-compatible origins, separated by commas. No paths.
CUSTOM_PROVIDER_ORIGINS=

# Environment defaults. Keys saved in the Mini App take precedence.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
